# Copy to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/roushan-ecommerce
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Admin account created by seed.js — only when both are set. Use a real
# email and a strong password here (and as ADMIN_EMAIL / ADMIN_PASSWORD
# in Render); never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
# Verified business WhatsApp number (digits only, no +). Used for order/enquiry messages.
WHATSAPP_NUMBER=918797777269
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
